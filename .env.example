# `make dev` copies this to .env, which is not committed. Every variable compose or the app reads, with a
# safe local default. Add a line here when the code reads a new one.

# The Postgres container (docker-compose.yml).
POSTGRES_DB=dibs
POSTGRES_USER=dibs
POSTGRES_PASSWORD=dibs
POSTGRES_PORT=5432

# The app. Spring maps SPRING_DATASOURCE_URL to spring.datasource.url, and so on.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/dibs
SPRING_DATASOURCE_USERNAME=dibs
SPRING_DATASOURCE_PASSWORD=dibs
